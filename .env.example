# Read by `docker compose` (and deploy/up.sh) from this directory. Copy to `.env` and adjust.
# All values are optional.

# Port the container serves the API and web app on (default 4380).
PROJECT_HUB_PORT=4380

# GitHub token for the Pipelines view. deploy/up.sh fills it from `gh auth token` when unset.
GITHUB_TOKEN=

# Other variables the server / host helper read (set them in your shell for `npm run dev`):
#   PROJECT_HUB_CONFIG       config file path (default ~/.config/project-hub/config.json)
#   PROJECT_HUB_HOST         bind address (default 127.0.0.1)
#   GITLAB_TOKEN             fallback token for gitlab.com (or set per host in Settings)
#   PROJECT_HUB_BROWSER_SOCK browser helper socket (default ~/.local/state/project-hub/browser.sock)
#   PROJECT_HUB_STATE        browser helper state dir (default ~/.local/state/project-hub)
#   PROJECT_HUB_CHROME       Chrome binary for the browser helper (default /usr/bin/google-chrome)
#   WEB_PORT / API_PORT      Vite dev server port (4311) / API port it proxies to (4310)
